{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "arachnemod:item/reaver_gauntlet_gui"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "on_false": {
        "type": "minecraft:model",
        "model": "arachnemod:item/reaver_gauntlet2"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "arachnemod:item/reaver_gauntlet_blocking"
      },
      "property": "minecraft:using_item"
    }
  }
}